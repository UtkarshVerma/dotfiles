#!/bin/sh
# Display the current battery status.

notify() {
    notify-send \
        --icon=battery-good-symbolic \
        --expire-time=4000 \
        --hint=string:x-canonical-private-synchronous:battery \
        "Battery" "$1"
}

print_capacity() {
    battery="$1"
    if [ ! -r "$battery/capacity" ]; then
        echo >&2 "error: could not read capacity from $battery"
        return 1
    fi

    capacity="$(cat "$battery/capacity")"
    if [ "$capacity" -gt 90 ]; then
        status=" "
    elif [ "$capacity" -gt 60 ]; then
        status=" "
    elif [ "$capacity" -gt 40 ]; then
        status=" "
    elif [ "$capacity" -gt 10 ]; then
        status=" "
    else
        status=" "
    fi

    if [ ! -r "$battery/status" ]; then
        echo >&2 "error: could not read status from $battery"
        return 2
    fi

    case "$(cat "$battery/status")" in
        Full) status=" " ;;
        Discharging)
            if [ "$capacity" -le 20 ]; then
                status="$status"
                color=1
            fi
            ;;
        Charging) status="󰚥$status" ;;
        "Not charging") status=" " ;;
        Unknown) status="? $status" ;;
        *) return 3 ;;
    esac

    display "$status$capacity%" "$color"
}

case "$BLOCK_BUTTON" in
    1) notify "$(acpi -b | awk -F ': |, ' '{printf "%s\n%s\n", $2, $4}')" ;;
    6) terminal -e "$EDITOR" "$0" ;;
esac

. sb-theme

# Attempt Mac battery first and then others.
if [ -d /sys/class/power_supply/macsmc-battery ]; then
    print_capacity /sys/class/power_supply/macsmc-battery
    exit
fi

